---
---

<section class="cta-section" id="trial">
  <!-- Blurred animated gradient mesh background -->
  <div class="cta-gradient-mesh" aria-hidden="true"></div>

  <div class="container cta-container fade-up-init">
    <h2 class="cta-headline">Ready to deploy your zero-hallucination assistant?</h2>
    
    <p class="cta-desc">
      Join security-conscious developer teams using botforweb to turn static documentation, manuals, and PDFs into an intelligent, PostgreSQL RLS-secured AI support channel. If you are interested, raise interest below and we will reach out to you.
    </p>
    
    <form class="cta-form" id="interestForm">
      <div class="cta-input-wrapper">
        <input type="email" required placeholder="Enter your work email" class="cta-input" id="interestEmail" aria-label="Work Email Address" />
        <button type="submit" class="btn btn-primary btn-cta-submit" id="interestSubmitBtn">
          Express Interest
        </button>
      </div>
      <div class="form-message" id="formMessage" aria-live="polite"></div>
    </form>
    
    <p class="cta-reassurance">Rest assured - we will get back to you within 24 hours.</p>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    position: relative;
    overflow: hidden;
    text-align: center;
  }

  /* Animated background gradient orb mesh */
  .cta-gradient-mesh {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(255, 87, 34, 0.07) 0%,
      rgba(255, 87, 34, 0.02) 40%,
      transparent 70%
    );
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
    animation: cta-glow 10s ease-in-out infinite alternate;
  }

  @keyframes cta-glow {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.8;
    }
    100% {
      transform: translate(-45%, -52%) scale(1.15);
      opacity: 1;
    }
  }

  .cta-container {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    z-index: 1;
    position: relative;
  }

  .cta-headline {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.045em;
    color: var(--text-primary);
  }

  .cta-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  .cta-form {
    width: 100%;
    max-width: 480px;
    margin-top: 0.5rem;
    position: relative;
    z-index: 2;
  }

  .cta-input-wrapper {
    display: flex;
    gap: 0.5rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 0.35rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .cta-input-wrapper:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(255, 87, 34, 0.2);
  }

  .cta-input {
    flex-grow: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 0.6rem 0.85rem;
    font-size: 0.95rem;
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .cta-input::placeholder {
    color: var(--text-light);
  }

  .btn-cta-submit {
    padding: 0.6rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-md);
  }

  .form-message {
    font-size: 0.875rem;
    margin-top: 0.75rem;
    font-weight: 500;
    transition: opacity 0.3s ease;
    opacity: 0;
    min-height: 20px;
  }

  .form-message.success {
    color: var(--success);
    opacity: 1;
  }

  .form-message.error {
    color: var(--error);
    opacity: 1;
  }

  .cta-reassurance {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .cta-section {
      padding: 4rem 0;
    }

    .cta-headline {
      font-size: 2rem;
    }

    .cta-desc {
      font-size: 0.975rem;
    }

    .cta-input-wrapper {
      flex-direction: column;
      background: transparent;
      border: none;
      padding: 0;
      gap: 0.75rem;
    }

    .cta-input-wrapper:focus-within {
      box-shadow: none;
    }

    .cta-input {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      padding: 0.75rem 1rem;
      width: 100%;
    }

    .cta-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(255, 87, 34, 0.2);
    }

    .btn-cta-submit {
      width: 100%;
      padding: 0.75rem;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('interestForm') as HTMLFormElement | null;
    const messageDiv = document.getElementById('formMessage');
    const submitBtn = document.getElementById('interestSubmitBtn') as HTMLButtonElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('interestEmail') as HTMLInputElement | null;
      if (emailInput && messageDiv && submitBtn) {
        submitBtn.disabled = true;
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Submitting...';

        setTimeout(() => {
          messageDiv.textContent = 'Thank you! We have received your request and will reach out shortly.';
          messageDiv.className = 'form-message success';
          emailInput.value = '';
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }, 800);
      }
    });
  });
</script>
