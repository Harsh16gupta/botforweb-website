---
---

<footer class="footer">
  <div class="container footer-container">
    
    <div class="footer-left">
      <a href="#" class="footer-logo">
        <span class="footer-logo-mark"></span>
        <span>botforweb</span>
      </a>
      <span class="footer-divider">|</span>
      <p class="footer-copyright">&copy; {new Date().getFullYear()} botforweb. All rights reserved.</p>
    </div>

    <div class="footer-right">
      <nav class="footer-nav">
        <a href="#features">Features</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#security">Security</a>
      </nav>
      <span class="footer-divider">|</span>
      <div class="social-links">
        <a href="#github" aria-label="Github">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        </a>
        <a href="#twitter" aria-label="Twitter">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg>
        </a>
        <a href="https://linkedin.com/company/botforweb" aria-label="LinkedIn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-color);
    padding: 1.5rem 0;
    color: var(--text-secondary);
    position: relative;
    z-index: 10;
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .footer-left,
  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-primary);
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .footer-logo-mark {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 3px;
    display: inline-block;
  }

  .footer-divider {
    color: var(--border-color);
    font-size: 0.85rem;
    user-select: none;
  }

  .footer-copyright {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  /* Navigation Links */
  .footer-nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-nav a {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    font-weight: 500;
  }

  .footer-nav a:hover {
    color: var(--text-primary);
  }

  /* Social links */
  .social-links {
    display: flex;
    gap: 1rem;
    color: var(--text-muted);
  }

  .social-links a {
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .social-links a:hover {
    color: var(--text-primary);
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      gap: 1.25rem;
      align-items: center;
      text-align: center;
      padding: 0.5rem 0;
    }

    .footer-divider {
      display: none;
    }

    .footer-left,
    .footer-right {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
