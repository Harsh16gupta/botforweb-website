---
---

<section class="hero-section" id="hero">
  <div class="hero-container container">
    <div class="hero-content">

      <!-- Badge -->
      <div class="badge-wrapper fade-up-init stagger-1">
        <span class="badge hero-badge">
          <span class="badge-dot"></span>
          ZERO-HALLUCINATION RAG ENGINE
        </span>
      </div>

      <!-- Headline -->
      <h1 class="hero-headline fade-up-init stagger-2" id="heroTitle">
        Your documentation.<br />
        Turned into a <span class="highlight-text">fact-checked</span> AI assistant.
      </h1>

      <!-- Sub-headline -->
      <p class="hero-subheadline fade-up-init stagger-3" id="heroSub">
        Upload product manuals, PDFs, and Markdown files. Instantly generate a public chatbot widget that answers user questions with zero hallucinations. Secured by PostgreSQL RLS and live on your site with a single script tag.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-actions fade-up-init stagger-4">
        <a href="https://app.botforweb.com/signup" class="btn btn-primary hero-btn-primary" id="heroBtnStart">Start Free Trial</a>
        <a href="#sandbox-section" class="btn btn-secondary hero-btn-secondary" id="heroBtnSandbox">
          Explore Interactive Sandbox <span class="arrow">→</span>
        </a>
      </div>

      <!-- Pipeline Card -->
      <div class="pipeline-wrapper fade-up-init stagger-5">
        <div class="pipeline-card" id="heroVisual">
          <!-- Terminal Top Bar -->
          <div class="pipeline-topbar">
            <div class="topbar-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <span class="pipeline-title">INGESTION PIPELINE</span>
          </div>

          <!-- Pipeline Body -->
          <div class="pipeline-body">

            <!-- Step 1 -->
            <div class="step-panel" id="pipelineStep1">
              <div class="step-num">01</div>
              <div class="step-content">
                <div class="step-header-row">
                  <h4>Parse & Chunk</h4>
                  <span class="status-indicator success">Ready</span>
                </div>
                <p class="step-description">Celery parses headers and chunks text asynchronously.</p>
                <div class="step-visual">
                  <div class="visual-file-item">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <path d="M14 2v6h6"/>
                    </svg>
                    <span class="filename">user_manual.pdf</span>
                    <span class="file-size">1.2 MB</span>
                    <div class="file-progress-bar"><div class="fill"></div></div>
                    <span class="percentage">100%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Connector -->
            <div class="step-connector">
              <div class="connector-line"></div>
            </div>

            <!-- Step 2 -->
            <div class="step-panel" id="pipelineStep2">
              <div class="step-num">02</div>
              <div class="step-content">
                <div class="step-header-row">
                  <h4>Generate Embeddings</h4>
                  <span class="status-indicator success">Isolated</span>
                </div>
                <p class="step-description">Generates dense vector indices stored under Postgres RLS namespaces.</p>
                <div class="step-visual">
                  <div class="db-status-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0110 0v4"/>
                    </svg>
                    <span>PostgreSQL Row-Level Isolation (RLS) Verified</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Connector -->
            <div class="step-connector">
              <div class="connector-line"></div>
            </div>

            <!-- Step 3 -->
            <div class="step-panel" id="pipelineStep3">
              <div class="step-num">03</div>
              <div class="step-content">
                <div class="step-header-row">
                  <h4>Deploy Widget</h4>
                  <span class="status-indicator live">Live</span>
                </div>
                <p class="step-description">Paste the single script tag to show the cited AI widget.</p>
                <div class="step-visual script-visual">
                  <div class="code-header">COPY EMBED SCRIPT</div>
                  <div class="code-body">
                    <code>&lt;script src="https://cdn.botforweb.com/widget.js" data-id="bfw_9273" async&gt;&lt;/script&gt;</code>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ─── Hero Section ─── */
  .hero-section {
    position: relative;
    padding-top: 10rem;
    padding-bottom: 5rem;
    background-color: var(--bg-primary);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  /* ─── Content Container ─── */
  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    gap: 1.5rem;
  }

  /* ─── Badge ─── */
  .badge-wrapper {
    display: flex;
    justify-content: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1.1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--success);
    animation: dot-pulse 2s infinite;
    flex-shrink: 0;
  }

  /* ─── Headline ─── */
  .hero-headline {
    font-size: 4.25rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--text-primary);
    letter-spacing: -0.04em;
    text-align: center;
    margin-bottom: 0;
  }

  .highlight-text {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }

  /* ─── Sub-headline ─── */
  .hero-subheadline {
    font-size: 1.05rem; /* Dropped subhead font size slightly */
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  /* ─── CTA Buttons ─── */
  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-btn-primary {
    padding: 0.85rem 2rem;
    font-size: 0.95rem;
  }

  .hero-btn-secondary {
    font-size: 0.95rem;
  }

  .hero-btn-secondary .arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .hero-btn-secondary:hover .arrow {
    transform: translateX(4px);
  }

  /* ─── Pipeline Card Wrapper ─── */
  .pipeline-wrapper {
    width: 100%;
    margin-top: 4rem;
    display: flex;
    justify-content: center;
  }

  .pipeline-card {
    max-width: 680px;
    width: 100%;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    position: relative;
    text-align: left;
  }

  /* ─── Terminal Top Bar ─── */
  .pipeline-topbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 40px;
    padding: 0 1.25rem;
    background-color: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
  }

  .topbar-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
  }

  .dot-red {
    background-color: var(--border-color);
  }

  .dot-yellow {
    background-color: var(--border-color);
  }

  .dot-green {
    background-color: var(--border-color);
  }

  .pipeline-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  /* ─── Pipeline Body ─── */
  .pipeline-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  /* ─── Step Panel ─── */
  .step-panel {
    display: flex;
    gap: 1.25rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    min-width: 22px;
    height: 24px;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .step-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .step-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .step-content h4 {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0;
    letter-spacing: -0.01em;
  }

  .status-indicator {
    font-size: 0.675rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .status-indicator.success {
    color: var(--success);
  }

  .status-indicator.live {
    color: var(--accent);
  }

  .step-description {
    font-size: 0.775rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.45;
  }

  /* ─── Step Connector ─── */
  .step-connector {
    display: flex;
    justify-content: flex-start;
    padding-left: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    height: 28px;
  }

  .connector-line {
    width: 1px;
    height: 100%;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--text-light) 0px,
      var(--text-light) 3px,
      transparent 3px,
      transparent 7px
    );
  }

  /* ─── Step Visual (shared) ─── */
  .step-visual {
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
  }

  /* Step 1: File Upload Visual */
  .visual-file-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-primary);
  }

  .visual-file-item svg {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .filename {
    font-weight: 600;
  }

  .file-size {
    color: var(--text-light);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .file-progress-bar {
    flex-grow: 1;
    height: 3px;
    background-color: var(--border-color);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin: 0 0.25rem;
    min-width: 40px;
  }

  .file-progress-bar .fill {
    width: 100%;
    height: 100%;
    background-color: var(--success);
    border-radius: var(--radius-full);
  }

  .percentage {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.65rem;
    color: var(--success);
  }

  /* Step 2: RLS Badge Visual */
  .db-status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .db-status-pill svg {
    color: var(--success);
    flex-shrink: 0;
  }

  /* Step 3: Code Snippet Visual */
  .step-visual.script-visual {
    padding: 0;
    overflow: hidden;
  }

  .code-header {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .code-body {
    padding: 0.625rem 0.75rem;
    overflow-x: auto;
  }

  .code-body code {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--accent-dark);
    white-space: nowrap;
    line-height: 1.5;
  }

  /* ─── Responsive: 768px ─── */
  @media (max-width: 768px) {
    .hero-section {
      padding-top: 7rem;
      padding-bottom: 3.5rem;
    }

    .hero-headline {
      font-size: 2.75rem;
    }

    .hero-subheadline {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 340px;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .pipeline-wrapper {
      margin-top: 3rem;
    }

    .pipeline-body {
      padding: 1.25rem;
    }

    .step-panel {
      gap: 0.75rem;
    }
  }

  /* ─── Responsive: 640px ─── */
  @media (max-width: 640px) {
    .hero-section {
      padding-top: 6rem;
      padding-bottom: 3rem;
    }

    .hero-headline {
      font-size: 2.25rem;
      letter-spacing: -0.04em;
    }

    .hero-subheadline {
      font-size: 0.95rem;
    }

    .hero-content {
      gap: 1.25rem;
    }

    .pipeline-body {
      padding: 1rem;
    }

    .step-header-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .visual-file-item {
      flex-wrap: wrap;
    }

    .file-progress-bar {
      order: 5;
      flex-basis: 100%;
      margin: 0.25rem 0 0 0;
    }

    .percentage {
      order: 4;
    }
  }
</style>
