---
---

<section class="hero-section" id="hero">
  <div class="hero-bg-gradients">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="hero-container container">
    <!-- Hero Header Content -->
    <div class="hero-content fade-up-init">
      <div class="badge-wrapper">
        <span class="badge hero-badge">
          <span class="badge-dot"></span>
          Now Active: Zero-Hallucination RAG Engine
        </span>
      </div>
      
      <h1 class="hero-headline" id="heroTitle">
        Turn Your Product Documentation <br />
        <span class="text-gradient">Into An Intelligent AI Chatbot</span>
      </h1>
      
      <p class="hero-subheadline" id="heroSub">
        Give your users instant, accurate answers grounded strictly in your files. Zero training required. Embed on your site with a single script tag.
      </p>

      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary btn-lg" id="heroBtnStart">Start Free Trial</a>
        <a href="#sandbox-section" class="btn btn-secondary btn-lg" id="heroBtnSandbox">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 2px;">
            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          View Interactive Sandbox
        </a>
      </div>
    </div>

    <!-- Product Visual Browser Mockup -->
    <div class="hero-mockup-wrapper fade-up-init delay-200" id="heroMockup">
      <div class="browser-mockup">
        <!-- Browser Top Bar -->
        <div class="browser-header">
          <div class="window-controls">
            <span class="control dot-red"></span>
            <span class="control dot-yellow"></span>
            <span class="control dot-green"></span>
          </div>
          <div class="browser-url-bar">
            <svg class="lock-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>dashboard.botforweb.com/projects/my-app</span>
          </div>
        </div>

        <!-- Browser Main Grid -->
        <div class="browser-content-grid">
          <!-- Left Pane (Dashboard Panel) -->
          <div class="dashboard-panel">
            <div class="panel-header">
              <h3>Knowledge Base</h3>
              <span class="panel-badge">3 Files</span>
            </div>

            <!-- Upload Area Mockup -->
            <div class="upload-dropzone">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
              </svg>
              <p class="upload-title">Drop PDF, MD, or JSON here</p>
              <p class="upload-subtitle">Maximum file size: 24MB</p>
            </div>

            <!-- File List -->
            <div class="mockup-file-list">
              <div class="file-item">
                <div class="file-info">
                  <svg class="file-icon text-indigo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                  </svg>
                  <div>
                    <p class="file-name">installation_guide.pdf</p>
                    <p class="file-meta">1.2 MB • PDF Document</p>
                  </div>
                </div>
                <span class="status-badge">Vectorized</span>
              </div>

              <div class="file-item">
                <div class="file-info">
                  <svg class="file-icon text-indigo" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>
                  </svg>
                  <div>
                    <p class="file-name">api_v1_reference.md</p>
                    <p class="file-meta">24 KB • Markdown</p>
                  </div>
                </div>
                <span class="status-badge">Vectorized</span>
              </div>
            </div>
          </div>

          <!-- Right Pane (Chat Preview Panel) -->
          <div class="preview-chat-panel">
            <div class="panel-header border-b">
              <div class="bot-profile">
                <div class="bot-avatar">AI</div>
                <div>
                  <h4>Widget Preview</h4>
                  <p class="bot-status">● Live on your website</p>
                </div>
              </div>
              <span class="preview-tag">Preview Widget</span>
            </div>

            <!-- Simulated Conversation -->
            <div class="preview-chat-body">
              <div class="msg-bubble msg-user">
                How do I install the chatbot widget?
              </div>

              <div class="msg-bubble msg-bot">
                <p>Paste this script tag into the head of your HTML file:</p>
                <div class="mockup-code-block">
                  <code>&lt;script src="https://cdn.botforweb.com/widget.js" data-id="proj_48f8a"&gt;&lt;/script&gt;</code>
                </div>
                <!-- Citation -->
                <div class="citation-tag">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                  </svg>
                  <span>Grounded Answer: <strong>installation_guide.pdf (p. 2)</strong></span>
                </div>
              </div>
            </div>

            <!-- Chat Footer Input -->
            <div class="preview-chat-footer">
              <div class="mockup-input">
                <span>Ask a question...</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 9.5rem;
    padding-bottom: 7rem;
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  /* Ambient glow effects behind hero */
  .hero-bg-gradients {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    border-radius: var(--radius-full);
    filter: blur(100px);
    opacity: 0.15;
  }

  .glow-1 {
    top: -50px;
    left: 20%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, var(--accent) 0%, transparent 70%);
  }

  .glow-2 {
    top: 100px;
    right: 20%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #10b981 0%, transparent 70%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    max-width: 840px;
    margin-bottom: 4.5rem;
  }

  .badge-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    background-color: rgba(79, 70, 229, 0.06);
    border: 1px solid rgba(79, 70, 229, 0.15);
    padding: 0.5rem 1.25rem;
    font-size: 0.85rem;
    animation: badgePulse 3s infinite ease-in-out;
  }

  .badge-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
  }

  @keyframes badgePulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.15);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(79, 70, 229, 0);
    }
  }

  .hero-headline {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--accent) 0%, #10b981 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subheadline {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 680px;
    margin: 0 auto 2.5rem auto;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn-lg {
    padding: 0.875rem 2rem;
    font-size: 1rem;
    border-radius: var(--radius-lg);
  }

  /* Mockup Visual styling */
  .hero-mockup-wrapper {
    width: 100%;
    max-width: 1060px;
    perspective: 1200px;
  }

  .browser-mockup {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-align: left;
    height: 480px;
    transition: transform var(--transition-slow);
  }

  .browser-mockup:hover {
    transform: translateY(-4px);
  }

  .browser-header {
    height: 44px;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    padding: 0 1rem;
    position: relative;
  }

  .window-controls {
    display: flex;
    gap: 6px;
    position: absolute;
    left: 1rem;
  }

  .control {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
  }

  .dot-red { background-color: #ef4444; }
  .dot-yellow { background-color: #f59e0b; }
  .dot-green { background-color: #10b981; }

  .browser-url-bar {
    margin: 0 auto;
    width: 320px;
    height: 26px;
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.675rem;
    color: var(--text-muted);
    gap: 4px;
  }

  .lock-icon {
    color: #10b981;
  }

  .browser-content-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    flex-grow: 1;
    overflow: hidden;
  }

  /* Left Panel - Dashboard Admin layout */
  .dashboard-panel {
    background-color: #ffffff;
    border-right: 1px solid var(--border-color);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    overflow-y: auto;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .panel-header h3 {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .panel-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .upload-dropzone {
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem 1rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--bg-secondary);
    transition: all var(--transition-fast);
  }

  .upload-dropzone:hover {
    border-color: var(--border-focus);
    background-color: var(--accent-soft);
  }

  .upload-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .upload-subtitle {
    font-size: 0.725rem;
    color: var(--text-light);
    margin-bottom: 0;
  }

  .mockup-file-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .file-item {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: #ffffff;
  }

  .file-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .file-icon {
    flex-shrink: 0;
  }

  .text-indigo {
    color: var(--accent);
  }

  .file-name {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .file-meta {
    font-size: 0.725rem;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .status-badge {
    font-size: 0.725rem;
    padding: 0.25rem 0.5rem;
    background-color: var(--success-soft);
    color: var(--success);
    border: 1px solid var(--success-light);
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  /* Right Panel - Chat Widget simulator */
  .preview-chat-panel {
    background-color: var(--bg-secondary);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .border-b {
    border-bottom: 1px solid var(--border-color);
  }

  .bot-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bot-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    color: #ffffff;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bot-profile h4 {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .bot-status {
    font-size: 0.7rem;
    color: var(--success);
    margin-bottom: 0;
  }

  .preview-tag {
    font-size: 0.725rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border-color);
    background-color: #ffffff;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  .preview-chat-body {
    flex-grow: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow-y: auto;
  }

  .msg-bubble {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.825rem;
    max-width: 85%;
    line-height: 1.5;
  }

  .msg-user {
    align-self: flex-end;
    background-color: var(--accent);
    color: #ffffff;
    border-bottom-right-radius: 2px;
  }

  .msg-bot {
    align-self: flex-start;
    background-color: #ffffff;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-bottom-left-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: var(--shadow-sm);
  }

  .mockup-code-block {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-primary);
    word-break: break-all;
  }

  .citation-tag {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.725rem;
    color: var(--accent);
    border-top: 1px solid var(--border-color);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
  }

  .citation-tag svg {
    color: var(--accent);
  }

  .preview-chat-footer {
    padding: 1rem 1.5rem;
    background-color: #ffffff;
    border-top: 1px solid var(--border-color);
  }

  .mockup-input {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.625rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--text-light);
    background-color: var(--bg-secondary);
  }

  .mockup-input svg {
    color: var(--text-muted);
  }

  /* Responsive styling */
  @media (max-width: 968px) {
    .browser-content-grid {
      grid-template-columns: 1fr;
      overflow-y: auto;
    }
    
    .browser-mockup {
      height: 600px;
    }

    .dashboard-panel {
      border-right: none;
      border-bottom: 1px solid var(--border-color);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 7rem;
      padding-bottom: 5rem;
    }

    .hero-headline {
      font-size: 2.5rem;
    }

    .hero-subheadline {
      font-size: 1.05rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      max-width: 320px;
      margin: 0 auto;
    }

    .btn-lg {
      width: 100%;
    }
  }
</style>
