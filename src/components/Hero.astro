---
---

<section class="hero-section" id="hero">
  <!-- Subtle top grid pattern -->
  <div class="hero-bg-grid"></div>

  <div class="hero-container container">
    <!-- Left Column: Copy & Actions -->
    <div class="hero-copy-column fade-up-init">
      <div class="badge-wrapper">
        <span class="badge hero-badge">
          Zero-Hallucination RAG Engine
        </span>
      </div>
      
      <h1 class="hero-headline" id="heroTitle">
        Your documentation. <br />
        Turned into a <span class="highlight-text">fact-checked</span> AI assistant.
      </h1>
      
      <p class="hero-subheadline" id="heroSub">
        Upload product manuals, PDFs, and Markdown files. Instantly generate a public chatbot widget that answers user questions with zero hallucinations. Secured by PostgreSQL RLS and live on your site with a single script tag.
      </p>

      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary btn-lg" id="heroBtnStart">Start Free Trial</a>
        <a href="#sandbox-section" class="btn-explore-link" id="heroBtnSandbox">
          Explore Interactive Sandbox <span class="arrow">→</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Pipeline Explainer Diagram -->
    <div class="hero-visual-column fade-up-init delay-200" id="heroVisual">
      <div class="pipeline-card">
        <div class="pipeline-header">
          <span class="pulse-green-dot"></span>
          <span class="pipeline-title">INGESTION & DEPLOYMENT PIPELINE</span>
        </div>

        <div class="pipeline-steps">
          
          <!-- Step 1: Upload -->
          <div class="step-panel" id="pipelineStep1">
            <div class="step-num">01</div>
            <div class="step-content">
              <div class="step-header-row">
                <h4>Parse & Chunk Document Sources</h4>
                <span class="status-indicator-text success">Ready</span>
              </div>
              <p class="step-description"> Celery parses headers and chunks text asynchronously.</p>
              
              <!-- Mini Ingestion Mockup -->
              <div class="mini-upload-visual">
                <div class="visual-file-item">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <path d="M14 2v6h6"/>
                  </svg>
                  <span class="filename">user_manual.pdf</span>
                  <span class="file-size">1.2 MB</span>
                  <div class="file-progress-bar"><div class="fill"></div></div>
                  <span class="percentage">100%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Connecting line -->
          <div class="step-connector"></div>

          <!-- Step 2: Vectorization & Isolation -->
          <div class="step-panel" id="pipelineStep2">
            <div class="step-num">02</div>
            <div class="step-content">
              <div class="step-header-row">
                <h4>Generate Embeddings & Isolate DB</h4>
                <span class="status-indicator-text success">Isolated</span>
              </div>
              <p class="step-description">Generates dense vector indices stored under Postgres RLS namespaces.</p>
              
              <!-- Vector & RLS Badge Visual -->
              <div class="vector-pipeline-visual">
                <div class="db-status-pill">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                  </svg>
                  <span>PostgreSQL Row-Level Isolation (RLS) Verified</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Connecting line -->
          <div class="step-connector"></div>

          <!-- Step 3: Embed Widget -->
          <div class="step-panel" id="pipelineStep3">
            <div class="step-num">03</div>
            <div class="step-content">
              <div class="step-header-row">
                <h4>Deploy Chat Widget Instantly</h4>
                <span class="status-indicator-text live">Live</span>
              </div>
              <p class="step-description">Paste the single script tag to show the cited AI widget.</p>
              
              <!-- Code block + Live chat output -->
              <div class="script-visual-container">
                <div class="code-header">COPY EMBED SCRIPT</div>
                <div class="code-body-wrapper">
                  <code>&lt;script src="https://cdn.botforweb.com/widget.js" data-id="bfw_9273" async&gt;&lt;/script&gt;</code>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 8rem;
    padding-bottom: 7.5rem;
    background-color: var(--bg-primary);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  .hero-bg-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: 40px 40px;
    background-image: 
      linear-gradient(to right, rgba(0, 0, 0, 0.01) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.01) 1px, transparent 1px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-copy-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
  }

  .badge-wrapper {
    display: flex;
    justify-content: flex-start;
  }

  .hero-badge {
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero-headline {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-primary);
    letter-spacing: -0.045em;
  }

  .highlight-text {
    position: relative;
    display: inline-block;
    color: var(--accent);
  }

  .hero-subheadline {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .btn-lg {
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
  }

  .btn-explore-link {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    position: relative;
    padding: 0.5rem 0;
  }

  .btn-explore-link .arrow {
    transition: transform var(--transition-fast);
  }

  .btn-explore-link:hover .arrow {
    transform: translateX(3px);
  }

  /* Right column pipeline cards */
  .pipeline-card {
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xl);
    padding: 1.75rem;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
    position: relative;
    z-index: 1;
  }

  .pipeline-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .pulse-green-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--success);
    animation: flowPulse 2s infinite ease-in-out;
  }

  @keyframes flowPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.5; }
  }

  .pipeline-title {
    font-family: var(--font-mono);
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .pipeline-steps {
    display: flex;
    flex-direction: column;
  }

  .step-panel {
    display: flex;
    gap: 1.25rem;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-light);
    height: 24px;
    display: flex;
    align-items: center;
  }

  .step-content {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .step-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step-content h4 {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0;
  }

  .status-indicator-text {
    font-size: 0.675rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status-indicator-text.success {
    color: var(--success);
  }

  .status-indicator-text.live {
    color: var(--accent);
  }

  .step-description {
    font-size: 0.775rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  /* Connecting lines between pipeline step panels */
  .step-connector {
    width: 1px;
    height: 20px;
    background-color: var(--border-color);
    margin-left: 10px;
    margin-top: 4px;
    margin-bottom: 4px;
  }

  /* Step 1 Internal Visual (File Item upload) */
  .mini-upload-visual {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
  }

  .visual-file-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-primary);
  }

  .visual-file-item svg {
    color: var(--accent);
    flex-shrink: 0;
  }

  .filename {
    font-weight: 600;
  }

  .file-size {
    color: var(--text-light);
    font-family: var(--font-mono);
  }

  .file-progress-bar {
    flex-grow: 1;
    height: 3px;
    background-color: var(--border-color);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin: 0 0.25rem;
  }

  .file-progress-bar .fill {
    width: 100%;
    height: 100%;
    background-color: var(--success);
  }

  .percentage {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--success);
  }

  /* Step 2 Internal Visual (Vector Security Isolation) */
  .vector-pipeline-visual {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
  }

  .db-status-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .db-status-pill svg {
    color: var(--success);
    flex-shrink: 0;
  }

  /* Step 3 Internal Visual (Embedded Script Code Container) */
  .script-visual-container {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background-color: var(--text-primary);
    color: #ffffff;
    overflow: hidden;
  }

  .code-header {
    background-color: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 0.05em;
  }

  .code-body-wrapper {
    padding: 0.625rem 0.75rem;
    overflow-x: auto;
  }

  .code-body-wrapper code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: #fda4af; /* Rose 300 / orange-like tag styling */
    white-space: nowrap;
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .hero-copy-column {
      text-align: center;
      align-items: center;
    }

    .badge-wrapper {
      justify-content: center;
    }

    .pipeline-card {
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 6.5rem;
      padding-bottom: 5.5rem;
    }

    .hero-headline {
      font-size: 2.75rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      width: 100%;
      max-width: 320px;
    }

    .btn-lg {
      width: 100%;
    }
  }
</style>
