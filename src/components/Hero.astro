---
---

<section class="hero-section" id="hero">
  <!-- Ambient Background Effects -->
  <div class="hero-bg-effects" aria-hidden="true">
    <div class="hero-gradient-orb hero-orb-1"></div>
    <div class="hero-gradient-orb hero-orb-2"></div>
    <div class="hero-gradient-orb hero-orb-3"></div>
  </div>

  <div class="hero-container container">
    <div class="hero-grid">

      <!-- ═══ LEFT COLUMN: Text & CTAs ═══ -->
      <div class="hero-left">
        <!-- Badge -->
        <div class="badge-wrapper fade-up-init stagger-1">
          <span class="badge hero-badge">
            <span class="badge-dot"></span>
            ZERO-HALLUCINATION AI
          </span>
        </div>

        <!-- Headline -->
        <h1 class="hero-headline fade-up-init stagger-2" id="heroTitle">
          Your docs, turned into a <span class="highlight-text highlight-underline">fact-checked</span> AI&nbsp;assistant.
        </h1>

        <!-- Sub-headline -->
        <p class="hero-subheadline fade-up-init stagger-3" id="heroSub">
          Upload PDFs and Markdown. Get a citation-grounded chatbot live on your site in under 5 minutes — with zero hallucinations guaranteed.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-actions fade-up-init stagger-4">
          <a href="#trial" class="btn btn-primary hero-btn-primary btn-pulse" id="heroBtnStart">
            Start Free Trial
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="#sandbox-section" class="btn btn-secondary hero-btn-secondary" id="heroBtnSandbox">
            See Live Demo <span class="arrow">→</span>
          </a>
        </div>

        <!-- Metrics Strip -->
        <div class="hero-metrics fade-up-init stagger-5">
          <div class="metric-item">
            <span class="metric-value">99.9%</span>
            <span class="metric-label">Uptime SLA</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-value">&lt;300ms</span>
            <span class="metric-label">Avg Response</span>
          </div>
          <div class="metric-divider"></div>
          <div class="metric-item">
            <span class="metric-value">AES-256</span>
            <span class="metric-label">Encryption</span>
          </div>
        </div>
      </div>

      <!-- ═══ RIGHT COLUMN: Product Visual ═══ -->
      <div class="hero-right fade-up-init stagger-3">
        <div class="hero-visual-wrapper">

          <!-- Floating Code Snippet (behind, top-left) -->
          <div class="floating-code-card" id="floatingCode">
            <div class="floating-code-header">
              <span class="fc-dot"></span>
              EMBED SCRIPT
            </div>
            <code>&lt;script src="widget.js" data-id="bfw_9273"&gt;&lt;/script&gt;</code>
          </div>

          <!-- Floating RLS Badge (behind, bottom-left) -->
          <div class="floating-rls-badge" id="floatingRLS">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
            <span>PostgreSQL RLS Verified</span>
          </div>

          <!-- Main Chat Widget Preview -->
          <div class="chat-widget-preview" id="heroWidget">
            <!-- Widget Header -->
            <div class="widget-header">
              <div class="widget-header-left">
                <div class="widget-avatar">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                </div>
                <div>
                  <div class="widget-title">Documentation Assistant</div>
                  <div class="widget-status">
                    <span class="widget-status-dot"></span>
                    Online · Zero-hallucination active
                  </div>
                </div>
              </div>
              <div class="widget-header-dots">
                <span></span><span></span><span></span>
              </div>
            </div>

            <!-- Chat Messages (animated) -->
            <div class="widget-chat-body" id="widgetChatBody">
              <!-- User message -->
              <div class="widget-msg widget-msg-user widget-msg-animate" id="heroMsg1">
                <div class="widget-msg-bubble user-bubble">How do I authenticate API requests?</div>
              </div>

              <!-- Bot response -->
              <div class="widget-msg widget-msg-bot widget-msg-animate" id="heroMsg2">
                <div class="widget-msg-bubble bot-bubble">
                  Include your API key in the <code>Authorization</code> header as a Bearer token:
                  <div class="widget-code-block">Authorization: Bearer bfw_live_948af7...</div>
                </div>
                <div class="widget-citation">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <span>Grounded: <strong>api_v1_reference.md</strong> §1.1</span>
                </div>
              </div>

              <!-- Second user message -->
              <div class="widget-msg widget-msg-user widget-msg-animate" id="heroMsg3">
                <div class="widget-msg-bubble user-bubble">What about rate limiting?</div>
              </div>

              <!-- Second bot response -->
              <div class="widget-msg widget-msg-bot widget-msg-animate" id="heroMsg4">
                <div class="widget-msg-bubble bot-bubble">
                  The default rate limit is <strong>100 requests/min</strong> per API key. Enterprise plans support custom limits via the dashboard.
                </div>
                <div class="widget-citation">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  <span>Grounded: <strong>api_v1_reference.md</strong> §2.3</span>
                </div>
              </div>
            </div>

            <!-- Widget Input Bar -->
            <div class="widget-input-bar">
              <span class="widget-input-placeholder">Ask about your documentation...</span>
              <div class="widget-send-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════
     HERO SECTION — SPLIT LAYOUT
     ═══════════════════════════════════════════ */

  .hero-section {
    position: relative;
    padding-top: 10rem;
    padding-bottom: 6rem;
    background-color: var(--bg-primary);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
    min-height: 90vh;
    display: flex;
    align-items: center;
  }

  /* ─── Background Effects ─── */
  .hero-bg-effects {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  .hero-gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }

  .hero-orb-1 {
    width: 700px;
    height: 500px;
    top: -20%;
    left: 25%;
    background: radial-gradient(ellipse at center, var(--accent-glow-strong) 0%, transparent 70%);
    animation: orbFloat1 15s ease-in-out infinite;
  }

  .hero-orb-2 {
    width: 500px;
    height: 400px;
    bottom: -10%;
    right: 10%;
    background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
    animation: orbFloat2 20s ease-in-out infinite;
  }

  .hero-orb-3 {
    width: 300px;
    height: 300px;
    top: 40%;
    right: 35%;
    background: radial-gradient(ellipse at center, var(--accent-glow) 0%, transparent 70%);
    animation: orbFloat3 12s ease-in-out infinite;
  }

  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, 20px); }
  }
  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(-20px, -15px); }
  }
  @keyframes orbFloat3 {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(15px, -25px); }
  }

  /* ─── Main Grid ─── */
  .hero-container {
    position: relative;
    z-index: 1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* ═══ LEFT COLUMN ═══ */
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .badge-wrapper {
    display: flex;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--radius-full);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background-color: var(--success);
    animation: dot-pulse 2s infinite;
    flex-shrink: 0;
  }

  .hero-headline {
    font-size: 3.75rem;
    font-weight: 800;
    line-height: 1.08;
    color: var(--text-primary);
    letter-spacing: -0.04em;
    margin-bottom: 0;
  }

  .highlight-text {
    position: relative;
    display: inline-block;
    color: var(--accent);
    -webkit-text-fill-color: var(--accent);
  }

  .hero-subheadline {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 520px;
    margin-bottom: 0;
  }

  /* ─── CTA Buttons ─── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-btn-primary {
    padding: 0.9rem 2rem;
    font-size: 0.95rem;
    gap: 0.5rem;
  }

  .hero-btn-primary svg {
    transition: transform var(--transition-fast);
  }

  .hero-btn-primary:hover svg {
    transform: translateX(3px);
  }

  .hero-btn-secondary {
    font-size: 0.95rem;
  }

  .hero-btn-secondary .arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .hero-btn-secondary:hover .arrow {
    transform: translateX(4px);
  }

  /* ─── Metrics Strip ─── */
  .hero-metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-color);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .metric-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .metric-divider {
    width: 1px;
    height: 28px;
    background-color: var(--border-color);
  }

  /* ═══ RIGHT COLUMN — PRODUCT VISUAL ═══ */
  .hero-right {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  /* ─── Floating Code Card ─── */
  .floating-code-card {
    position: absolute;
    top: -24px;
    left: -40px;
    z-index: 10;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0;
    box-shadow: var(--shadow-lg);
    font-size: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px) rotate(-2deg);
    animation: floatIn 0.6s ease-out 1.2s forwards;
  }

  .floating-code-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.6rem;
    background: var(--bg-tertiary);
    border-bottom: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .fc-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
  }

  .floating-code-card code {
    display: block;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent-dark);
    white-space: nowrap;
  }

  /* ─── Floating RLS Badge ─── */
  .floating-rls-badge {
    position: absolute;
    bottom: 40px;
    left: -30px;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-secondary);
    border: 1px solid var(--success-light);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.75rem;
    box-shadow: var(--shadow-md);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--success);
    opacity: 0;
    transform: translateY(10px) rotate(1deg);
    animation: floatIn 0.6s ease-out 1.8s forwards;
  }

  .floating-rls-badge svg {
    color: var(--success);
    flex-shrink: 0;
  }

  @keyframes floatIn {
    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  /* ─── Main Chat Widget ─── */
  .chat-widget-preview {
    position: relative;
    z-index: 5;
    width: 100%;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  :global(html.dark) .chat-widget-preview {
    box-shadow: var(--shadow-xl), 0 0 100px rgba(255, 87, 34, 0.04);
  }

  .chat-widget-preview:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl), 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  :global(html.dark) .chat-widget-preview:hover {
    box-shadow: var(--shadow-xl), 0 0 120px rgba(255, 87, 34, 0.06), 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  /* Widget Header */
  .widget-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-tertiary);
  }

  .widget-header-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .widget-avatar {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: var(--text-primary);
    color: var(--bg-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .widget-title {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .widget-status {
    font-size: 0.65rem;
    color: var(--success);
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .widget-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--success);
    animation: dot-pulse 2s infinite;
  }

  .widget-header-dots {
    display: flex;
    gap: 4px;
  }

  .widget-header-dots span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-light);
  }

  /* Chat Body */
  .widget-chat-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 300px;
    max-height: 340px;
    overflow: hidden;
  }

  .widget-msg {
    display: flex;
    flex-direction: column;
    max-width: 88%;
  }

  .widget-msg-user {
    align-self: flex-end;
  }

  .widget-msg-bot {
    align-self: flex-start;
  }

  .widget-msg-bubble {
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-md);
    font-size: 0.8rem;
    line-height: 1.5;
    word-break: break-word;
  }

  .user-bubble {
    background: var(--accent);
    color: #ffffff;
    border-bottom-right-radius: 2px;
  }

  .bot-bubble {
    background: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    border-bottom-left-radius: 2px;
  }

  .bot-bubble code {
    background: var(--bg-tertiary);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-dark);
  }

  .widget-code-block {
    margin-top: 0.5rem;
    padding: 0.4rem 0.6rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-primary);
    overflow-x: auto;
  }

  /* Citation Badge */
  .widget-citation {
    margin-top: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    color: var(--success);
    font-weight: 500;
  }

  .widget-citation svg {
    flex-shrink: 0;
    color: var(--success);
  }

  .widget-citation strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Widget Input Bar */
  .widget-input-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--border-color);
    background: var(--bg-tertiary);
  }

  .widget-input-placeholder {
    font-size: 0.775rem;
    color: var(--text-light);
    font-weight: 400;
  }

  .widget-send-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ─── Message Entrance Animations ─── */
  .widget-msg-animate {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .widget-msg-animate.msg-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ═══ RESPONSIVE ═══ */

  @media (max-width: 968px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
      text-align: center;
    }

    .hero-left {
      align-items: center;
      text-align: center;
    }

    .hero-headline {
      font-size: 3rem;
    }

    .hero-subheadline {
      max-width: 580px;
      margin: 0 auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-metrics {
      justify-content: center;
    }

    .hero-visual-wrapper {
      max-width: 400px;
    }

    .floating-code-card {
      left: -10px;
      top: -16px;
    }

    .floating-rls-badge {
      left: -10px;
      bottom: 30px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: 7.5rem;
      padding-bottom: 4rem;
      min-height: auto;
    }

    .hero-headline {
      font-size: 2.5rem;
    }

    .hero-subheadline {
      font-size: 1rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      max-width: 340px;
      margin: 0 auto;
    }

    .hero-btn-primary,
    .hero-btn-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .hero-metrics {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .metric-divider {
      display: none;
    }

    .floating-code-card,
    .floating-rls-badge {
      display: none;
    }

    .widget-chat-body {
      min-height: 260px;
      max-height: 280px;
    }
  }

  @media (max-width: 480px) {
    .hero-section {
      padding-top: 6.5rem;
      padding-bottom: 3rem;
    }

    .hero-headline {
      font-size: 2.1rem;
    }

    .hero-metrics {
      gap: 0.75rem;
    }

    .metric-value {
      font-size: 0.8rem;
    }

    .metric-label {
      font-size: 0.625rem;
    }
  }

  /* ─── Reduced Motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .hero-gradient-orb {
      animation: none !important;
    }
    .floating-code-card,
    .floating-rls-badge {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
    .widget-msg-animate {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Trigger highlight underline animation
    const highlightEl = document.querySelector('.hero-headline .highlight-underline');
    if (highlightEl) {
      setTimeout(() => highlightEl.classList.add('animate'), 800);
    }

    // Animate chat messages sequentially when widget enters viewport
    const widget = document.getElementById('heroWidget');
    const messages = document.querySelectorAll('.widget-msg-animate');

    if (widget && messages.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            messages.forEach((msg, index) => {
              setTimeout(() => {
                msg.classList.add('msg-visible');
              }, 400 + (index * 500)); // 400ms initial delay, 500ms between each
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      observer.observe(widget);
    }
  });
</script>
