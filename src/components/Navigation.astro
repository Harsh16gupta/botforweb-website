---
---

<header class="navbar" id="globalNavbar">
  <div class="nav-inner">
    <!-- Typographic Logo -->
    <a href="#" class="logo" id="navLogo">
      <span class="logo-mark"></span>
      <span class="logo-text">bot<span>forweb</span></span>
    </a>

    <!-- Nav Links (Center) -->
    <nav class="nav-links" id="navLinks">
      <a href="#features" class="nav-link">Features</a>
      <a href="#how-it-works" class="nav-link">How It Works</a>
      <a href="#security" class="nav-link">Security</a>
      <a href="#pricing" class="nav-link">Pricing</a>
    </nav>

    <!-- CTAs (Right) -->
    <div class="nav-actions" id="navActions">
      <!-- Theme Toggle Switcher -->
      <button class="theme-toggle-btn" id="themeToggleBtn" aria-label="Toggle theme">
        <!-- Sun Icon -->
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon Icon -->
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>

      <a href="https://app.botforweb.com/login" class="btn-signin" id="btnSignIn">Sign In</a>
      <a href="https://app.botforweb.com/signup" class="btn-trial" id="btnStartTrial">Start Free Trial</a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>

  <!-- Mobile Slide-Down Panel -->
  <div class="mobile-panel" id="mobilePanel">
    <nav class="mobile-panel-links">
      <a href="#features" class="mobile-link">Features</a>
      <a href="#how-it-works" class="mobile-link">How It Works</a>
      <a href="#security" class="mobile-link">Security</a>
      <a href="#pricing" class="mobile-link">Pricing</a>
    </nav>
    <div class="mobile-panel-actions">
      <div class="mobile-theme-row">
        <span>Dark Theme</span>
        <button class="theme-toggle-btn" id="mobileThemeToggleBtn" aria-label="Toggle theme">
          <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
      </div>
      <a href="https://app.botforweb.com/login" class="mobile-signin">Sign In</a>
      <a href="https://app.botforweb.com/signup" class="mobile-cta">Start Free Trial</a>
    </div>
  </div>
</header>

<style>
  /* ── Floating Pill Navbar ── */
  .navbar {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    max-width: 900px;
    width: calc(100% - 2rem);
    z-index: 1000;
    transition:
      background var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 1.5rem;
    border-radius: var(--radius-full);
    background: var(--surface-glass);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid var(--border-color);
    transition:
      background var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
  }

  /* Scroll state */
  :global(.navbar-scrolled) .nav-inner {
    background: var(--surface-glass);
    box-shadow: var(--shadow-md);
    border-color: var(--border-hover);
  }

  /* ── Logo ── */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-mark {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 2px;
    display: inline-block;
    transition: transform var(--transition-normal);
  }

  .logo:hover .logo-mark {
    transform: rotate(45deg);
  }

  .logo-text {
    font-family: var(--font-title);
    font-weight: 500;
    color: var(--text-primary);
    font-size: 1.05rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .logo-text span {
    font-weight: 800;
  }

  /* ── Center Nav Links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-link {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--overlay-hover);
  }

  /* ── Right Actions ── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-signin {
    font-size: 0.825rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .btn-signin:hover {
    color: var(--text-primary);
  }

  .btn-trial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-btn);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  .btn-trial:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-trial:active {
    transform: translateY(0);
  }

  /* ── Theme Toggle Button ── */
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-md);
    background: transparent;
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .theme-toggle-btn:hover {
    color: var(--text-primary);
    background: var(--overlay-hover);
    border-color: var(--border-hover);
  }

  .sun-icon {
    display: block;
  }
  .moon-icon {
    display: none;
  }

  :global(html.dark) .sun-icon {
    display: none;
  }
  :global(html.dark) .moon-icon {
    display: block;
  }

  /* ── Hamburger Toggle ── */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 1.5px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition:
      transform var(--transition-normal),
      opacity var(--transition-normal);
    transform-origin: center;
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle.active .bar:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ── Mobile Panel ── */
  .mobile-panel {
    display: none;
    flex-direction: column;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    margin-top: 0.5rem;
    padding: 1rem;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--transition-normal),
      transform var(--transition-normal);
    pointer-events: none;
  }

  .mobile-panel.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    animation: panelSlideDown 0.25s ease-out forwards;
  }

  @keyframes panelSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-panel-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-md);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .mobile-link:hover {
    color: var(--text-primary);
    background: var(--overlay-hover);
  }

  .mobile-panel-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-color);
  }

  .mobile-theme-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .mobile-signin {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    text-align: center;
    padding: 0.55rem 0;
    border-radius: var(--radius-btn);
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .mobile-signin:hover {
    color: var(--text-primary);
    background: var(--overlay-hover);
  }

  .mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-btn);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .mobile-cta:hover {
    background: var(--accent-hover);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-actions {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-inner {
      padding: 0 1.25rem;
    }
  }

  @media (min-width: 769px) {
    .mobile-panel {
      display: none !important;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      top: 0.5rem;
      width: calc(100% - 1rem);
    }

    .nav-inner {
      height: 48px;
      padding: 0 1rem;
    }

    .logo-text {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('globalNavbar');
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const mobilePanel = document.getElementById('mobilePanel');

    // Handle scroll — add shadow + denser background
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar?.classList.add('navbar-scrolled');
      } else {
        navbar?.classList.remove('navbar-scrolled');
      }
    });

    // Mobile menu toggle logic
    toggleBtn?.addEventListener('click', () => {
      toggleBtn.classList.toggle('active');
      mobilePanel?.classList.toggle('active');
    });

    // Close menu when clicking any mobile link
    const mobileLinks = document.querySelectorAll('.mobile-link, .mobile-signin, .mobile-cta');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn?.classList.remove('active');
        mobilePanel?.classList.remove('active');
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (
        mobilePanel?.classList.contains('active') &&
        !navbar?.contains(target)
      ) {
        toggleBtn?.classList.remove('active');
        mobilePanel?.classList.remove('active');
      }
    });

    // Theme toggle buttons script
    const themeToggleBtn = document.getElementById('themeToggleBtn');
    const mobileThemeToggleBtn = document.getElementById('mobileThemeToggleBtn');

    const toggleTheme = () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    themeToggleBtn?.addEventListener('click', toggleTheme);
    mobileThemeToggleBtn?.addEventListener('click', toggleTheme);
  });
</script>
