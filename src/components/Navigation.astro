---
---

<header class="navbar" id="globalNavbar">
  <div class="nav-container container">
    <!-- Typographic Logo -->
    <a href="#" class="logo" id="navLogo">
      <span class="logo-mark"></span>
      <span class="logo-text">bot<span>forweb</span></span>
    </a>

    <!-- Nav Links (Center) -->
    <nav class="nav-links" id="navLinks">
      <a href="#features" class="nav-link">Features</a>
      <a href="#how-it-works" class="nav-link">How It Works</a>
      <a href="#security" class="nav-link">Security</a>
      <a href="#pricing" class="nav-link">Pricing</a>
    </nav>

    <!-- CTAs (Right) -->
    <div class="nav-actions" id="navActions">
      <a href="#signin" class="btn-signin" id="btnSignIn">Sign In</a>
      <a href="#pricing" class="btn btn-primary nav-trial-btn" id="btnStartTrial">Start Free Trial</a>
    </div>

    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-color);
    z-index: 1000;
    display: flex;
    align-items: center;
    transition: all var(--transition-fast);
  }

  :global(.navbar-scrolled) {
    box-shadow: var(--shadow-sm);
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  /* Typographic Logo styling */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-mark {
    width: 8px;
    height: 8px;
    background-color: var(--accent);
    border-radius: 1px;
    display: inline-block;
    transition: transform var(--transition-normal);
  }

  .logo:hover .logo-mark {
    transform: rotate(45deg);
  }

  .logo-text {
    font-family: var(--font-title);
    font-weight: 500;
    color: var(--text-primary);
    font-size: 1.125rem;
    letter-spacing: -0.03em;
  }

  .logo-text span {
    font-weight: 800;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    padding: 0.5rem 0;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .btn-signin {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .btn-signin:hover {
    color: var(--text-primary);
  }

  .nav-trial-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  /* Hamburger Menu Toggle Button */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 20px;
    height: 20px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 1.5px;
    background-color: var(--text-primary);
    transition: all var(--transition-normal);
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .nav-links {
      display: none; /* hidden on mobile initially */
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: #ffffff;
      border-bottom: 1px solid var(--border-color);
      flex-direction: column;
      padding: 1.5rem var(--container-padding);
      gap: 1.25rem;
      align-items: flex-start;
      box-shadow: var(--shadow-md);
    }

    .nav-links.active {
      display: flex;
    }

    .nav-actions {
      display: none; /* hidden on mobile initially */
      position: absolute;
      top: calc(100% + 180px); /* Positioned below links menu */
      left: 0;
      width: 100%;
      background-color: #ffffff;
      padding: 0 var(--container-padding) 2rem var(--container-padding);
      flex-direction: column;
      gap: 1rem;
      box-shadow: var(--shadow-md);
      border-bottom: 1px solid var(--border-color);
    }

    .nav-actions.active {
      display: flex;
      top: calc(100% + 180px);
    }

    .mobile-toggle {
      display: flex;
    }

    /* Transform hamburger into close sign when menu is open */
    .mobile-toggle.active .bar:nth-child(1) {
      transform: translateY(4px) rotate(45deg);
    }
    .mobile-toggle.active .bar:nth-child(2) {
      transform: translateY(-3.5px) rotate(-45deg);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.getElementById('globalNavbar');
    const toggleBtn = document.getElementById('mobileMenuToggle');
    const navLinks = document.getElementById('navLinks');
    const navActions = document.getElementById('navActions');

    // Handle scroll shrinking navbar shadow
    window.addEventListener('scroll', () => {
      if (window.scrollY > 10) {
        navbar?.classList.add('navbar-scrolled');
      } else {
        navbar?.classList.remove('navbar-scrolled');
      }
    });

    // Mobile menu toggle logic
    toggleBtn?.addEventListener('click', () => {
      toggleBtn.classList.toggle('active');
      navLinks?.classList.toggle('active');
      navActions?.classList.toggle('active');
    });

    // Close menu when clicking a link
    const links = document.querySelectorAll('.nav-link');
    links.forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn?.classList.remove('active');
        navLinks?.classList.remove('active');
        navActions?.classList.remove('active');
      });
    });
  });
</script>
