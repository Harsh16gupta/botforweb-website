---
---

<section class="pricing-section" id="pricing">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header fade-up-init">
      <span class="badge">Simple Pricing</span>
      <h2>Predictable Plans Built To Scale</h2>
      <p class="section-desc">
        Start free, test your models, and scale as your user query volume grows. All plans feature full PostgreSQL Row-Level Security isolation.
      </p>

      <!-- Segmented Toggle Control -->
      <div class="pricing-toggle-container">
        <button class="toggle-tab active" id="btnToggleMonthly" aria-label="Bill monthly">Monthly</button>
        <button class="toggle-tab" id="btnToggleAnnually" aria-label="Bill annually">
          Annually
          <span class="discount-badge">Save 20%</span>
        </button>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="pricing-grid">
      
      <!-- Starter Card -->
      <div class="pricing-card fade-up-init delay-100" id="cardStarter">
        <div class="card-header">
          <h3>Starter</h3>
          <p class="card-desc">For small product documentation and scaling startups.</p>
          <div class="price-container">
            <span class="currency">$</span>
            <span class="price-value" id="priceStarter">199</span>
            <span class="duration" id="durationStarter">/mo</span>
          </div>
        </div>
        
        <div class="card-body">
          <ul class="features-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Up to <strong>5,000</strong> monthly queries</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>50</strong> document uploads (PDF, MD)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>1 API Key & Widget Embed</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PostgreSQL RLS security isolation</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Standard email support</span>
            </li>
          </ul>
        </div>
        
        <div class="card-footer">
          <a href="https://app.botforweb.com/signup?plan=starter" class="btn btn-secondary w-full" id="btnChooseStarter">Choose Starter</a>
        </div>
      </div>

      <!-- Growth Card (Featured with High-Contrast Border) -->
      <div class="pricing-card featured fade-up-init delay-200" id="cardGrowth">
        <div class="featured-badge">Most Popular</div>
        <div class="card-header">
          <h3>Growth</h3>
          <p class="card-desc">For active customer support centers and scaling companies.</p>
          <div class="price-container">
            <span class="currency">$</span>
            <span class="price-value" id="priceGrowth">799</span>
            <span class="duration" id="durationGrowth">/mo</span>
          </div>
        </div>
        
        <div class="card-body">
          <ul class="features-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Up to <strong>50,000</strong> monthly queries</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>Unlimited</strong> document uploads*</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Unlimited API Keys & Widgets</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PostgreSQL RLS security isolation</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Priority 24/7 Slack support</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Custom domain configuration</span>
            </li>
          </ul>
        </div>
        
        <div class="card-footer">
          <a href="https://app.botforweb.com/signup?plan=growth" class="btn btn-primary w-full" id="btnChooseGrowth">Choose Growth</a>
        </div>
      </div>

    </div>

    <!-- Small Note -->
    <p class="pricing-disclaimer fade-up-init">
      * Growth plan document upload is subjected to a fair-use cap of 1,000 documents per project namespace. Custom volume layouts are available on Enterprise agreements.
    </p>

  </div>
</section>

<style>
  .pricing-section {
    padding: 8rem 0;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }

  /* Segmented Toggle Control */
  .pricing-toggle-container {
    display: inline-flex;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 2px;
  }

  .toggle-tab {
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toggle-tab:hover {
    color: var(--text-primary);
  }

  .toggle-tab.active {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
    font-weight: 600;
  }

  .discount-badge {
    font-size: 0.65rem;
    background-color: var(--success-soft);
    color: var(--success);
    border: 1px solid var(--success-light);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.4rem;
    font-weight: 600;
  }

  /* Pricing Cards Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
    align-items: stretch;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3rem 2.5rem;
    position: relative;
    background: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    transition: all var(--transition-normal);
  }

  .pricing-card:hover {
    border-color: var(--border-hover);
  }

  /* Featured card styling - Bold border, no colored shadow glows */
  .pricing-card.featured {
    border-color: var(--text-primary);
  }

  .featured-badge {
    position: absolute;
    top: 1.5rem;
    right: 2.5rem;
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-primary);
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .card-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 1.5rem;
  }

  .price-container {
    display: flex;
    align-items: baseline;
  }

  .currency {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-right: 0.125rem;
  }

  .price-value {
    font-size: 3.75rem;
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    transition: all var(--transition-normal);
  }

  .duration {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-left: 0.25rem;
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 2.5rem;
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .features-list li svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-footer .w-full {
    width: 100%;
  }

  .pricing-disclaimer {
    text-align: center;
    max-width: 600px;
    margin: 2.5rem auto 0 auto;
    font-size: 0.775rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .pricing-card {
      padding: 2.5rem 2rem;
    }

    .featured-badge {
      top: 1.25rem;
      right: 2rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnMonthly = document.getElementById('btnToggleMonthly');
    const btnAnnually = document.getElementById('btnToggleAnnually');
    
    const priceStarter = document.getElementById('priceStarter');
    const priceGrowth = document.getElementById('priceGrowth');
    const durationStarter = document.getElementById('durationStarter');
    const durationGrowth = document.getElementById('durationGrowth');

    // Monthly vs Annual values
    const starterPrices = { monthly: '199', annual: '159' };
    const growthPrices = { monthly: '799', annual: '639' };

    const setBillingMode = (isAnnual: boolean) => {
      if (isAnnual) {
        btnMonthly?.classList.remove('active');
        btnAnnually?.classList.add('active');
        
        // Update starter
        if (priceStarter) priceStarter.textContent = starterPrices.annual;
        if (durationStarter) durationStarter.textContent = '/mo billed annually';
        
        // Update growth
        if (priceGrowth) priceGrowth.textContent = growthPrices.annual;
        if (durationGrowth) durationGrowth.textContent = '/mo billed annually';
      } else {
        btnMonthly?.classList.add('active');
        btnAnnually?.classList.remove('active');
        
        // Update starter
        if (priceStarter) priceStarter.textContent = starterPrices.monthly;
        if (durationStarter) durationStarter.textContent = '/mo';
        
        // Update growth
        if (priceGrowth) priceGrowth.textContent = growthPrices.monthly;
        if (durationGrowth) durationGrowth.textContent = '/mo';
      }

      // Add a quick visual swap animation
      [priceStarter, priceGrowth].forEach(el => {
        if (el) {
          el.style.transform = 'scale(0.97)';
          el.style.opacity = '0.8';
          setTimeout(() => {
            el.style.transform = 'scale(1)';
            el.style.opacity = '1';
          }, 100);
        }
      });
    };

    // Toggle click listeners
    btnMonthly?.addEventListener('click', () => setBillingMode(false));
    btnAnnually?.addEventListener('click', () => setBillingMode(true));
  });
</script>
