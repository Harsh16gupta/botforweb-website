---
---

<section class="pricing-section" id="pricing">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header fade-up-init">
      <span class="badge">Simple Pricing</span>
      <h2>Predictable Plans Built To Scale</h2>
      <p class="section-desc">
        Start free, test your models, and scale as your user query volume grows. All plans feature full PostgreSQL Row-Level Security isolation.
      </p>

      <!-- Toggle Container -->
      <div class="pricing-toggle-container">
        <span class="toggle-label active" id="toggleLabelMonthly">Billed Monthly</span>
        <button class="pricing-toggle-btn" id="billingToggle" aria-label="Toggle billing frequency">
          <span class="toggle-slider"></span>
        </button>
        <span class="toggle-label" id="toggleLabelAnnually">
          Billed Annually
          <span class="discount-badge">Save 20%</span>
        </span>
      </div>
    </div>

    <!-- Pricing Grid -->
    <div class="pricing-grid">
      
      <!-- Starter Card -->
      <div class="card pricing-card fade-up-init delay-100" id="cardStarter">
        <div class="card-header">
          <h3>Starter</h3>
          <p class="card-desc">For small product documentation and scaling startups.</p>
          <div class="price-container">
            <span class="currency">$</span>
            <span class="price-value" id="priceStarter">199</span>
            <span class="duration" id="durationStarter">/mo</span>
          </div>
        </div>
        
        <div class="card-body">
          <ul class="features-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Up to <strong>5,000</strong> monthly queries</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>50</strong> document uploads (PDF, MD)</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>1 API Key & Widget Embed</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PostgreSQL RLS security isolation</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Standard email support</span>
            </li>
          </ul>
        </div>
        
        <div class="card-footer">
          <a href="#trial" class="btn btn-secondary w-full" id="btnChooseStarter">Choose Starter</a>
        </div>
      </div>

      <!-- Growth Card (Featured) -->
      <div class="card pricing-card featured fade-up-init delay-200" id="cardGrowth">
        <div class="featured-badge">Most Popular</div>
        <div class="card-header">
          <h3>Growth</h3>
          <p class="card-desc">For active customer support centers and scaling companies.</p>
          <div class="price-container">
            <span class="currency">$</span>
            <span class="price-value" id="priceGrowth">799</span>
            <span class="duration" id="durationGrowth">/mo</span>
          </div>
        </div>
        
        <div class="card-body">
          <ul class="features-list">
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Up to <strong>50,000</strong> monthly queries</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span><strong>Unlimited</strong> document uploads*</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Unlimited API Keys & Widgets</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>PostgreSQL RLS security isolation</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Priority 24/7 Slack support</span>
            </li>
            <li>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Custom domain configuration</span>
            </li>
          </ul>
        </div>
        
        <div class="card-footer">
          <a href="#trial" class="btn btn-primary w-full" id="btnChooseGrowth">Choose Growth</a>
        </div>
      </div>

    </div>

    <!-- Small Note -->
    <p class="pricing-disclaimer fade-up-init">
      * Growth plan document upload is subjected to a fair-use cap of 1,000 documents per project namespace. Custom volume layouts are available on Enterprise agreements.
    </p>

  </div>
</section>

<style>
  .pricing-section {
    padding: 7.5rem 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    max-width: 650px;
    margin: 0 auto 4rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  /* Toggle button design */
  .pricing-toggle-container {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background-color: #ffffff;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    padding: 0.375rem 1rem;
    box-shadow: var(--shadow-sm);
  }

  .toggle-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .toggle-label.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .discount-badge {
    font-size: 0.7rem;
    background-color: var(--success-soft);
    color: var(--success);
    border: 1px solid var(--success-light);
    border-radius: var(--radius-full);
    padding: 0.125rem 0.5rem;
    font-weight: 600;
  }

  .pricing-toggle-btn {
    width: 44px;
    height: 24px;
    background-color: var(--accent-light);
    border: none;
    border-radius: var(--radius-full);
    position: relative;
    cursor: pointer;
    outline: none;
    transition: background-color var(--transition-normal);
  }

  .pricing-toggle-btn.active {
    background-color: var(--accent);
  }

  .toggle-slider {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-full);
    background-color: #ffffff;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-normal);
  }

  .pricing-toggle-btn.active .toggle-slider {
    transform: translateX(20px);
  }

  /* Pricing Cards Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
    align-items: start;
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 3rem 2.5rem;
    position: relative;
  }

  /* Highlight/Featured card styling */
  .pricing-card.featured {
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
    background-color: #ffffff;
  }

  .featured-badge {
    position: absolute;
    top: 1.5rem;
    right: 2.5rem;
    font-size: 0.725rem;
    font-weight: 700;
    color: var(--accent);
    background-color: var(--accent-soft);
    border: 1px solid var(--accent-light);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .card-header h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin-bottom: 1.5rem;
  }

  .price-container {
    display: flex;
    align-items: baseline;
  }

  .currency {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-right: 0.125rem;
  }

  .price-value {
    font-size: 3.5rem;
    font-family: var(--font-title);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    transition: all var(--transition-normal);
  }

  .duration {
    font-size: 1rem;
    color: var(--text-muted);
    margin-left: 0.25rem;
  }

  .card-body {
    flex-grow: 1;
    margin-bottom: 2.5rem;
  }

  .features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .features-list li svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-footer .w-full {
    width: 100%;
  }

  .pricing-disclaimer {
    text-align: center;
    max-width: 600px;
    margin: 2.5rem auto 0 auto;
    font-size: 0.775rem;
    color: var(--text-light);
    line-height: 1.5;
  }

  /* Responsive styling */
  @media (max-width: 768px) {
    .section-header h2 {
      font-size: 2rem;
    }
    
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .pricing-card {
      padding: 2.25rem 1.75rem;
    }

    .featured-badge {
      top: 1.25rem;
      right: 1.75rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('billingToggle');
    const labelMonthly = document.getElementById('toggleLabelMonthly');
    const labelAnnually = document.getElementById('toggleLabelAnnually');
    
    const priceStarter = document.getElementById('priceStarter');
    const priceGrowth = document.getElementById('priceGrowth');
    const durationStarter = document.getElementById('durationStarter');
    const durationGrowth = document.getElementById('durationGrowth');

    let isAnnual = false;

    // Monthly vs Annual values
    const starterPrices = { monthly: '199', annual: '159' };
    const growthPrices = { monthly: '799', annual: '639' };

    const updateBilling = () => {
      isAnnual = !isAnnual;
      
      if (isAnnual) {
        toggleBtn?.classList.add('active');
        labelMonthly?.classList.remove('active');
        labelAnnually?.classList.add('active');
        
        // Update starter
        if (priceStarter) priceStarter.textContent = starterPrices.annual;
        if (durationStarter) durationStarter.textContent = '/mo billed annually';
        
        // Update growth
        if (priceGrowth) priceGrowth.textContent = growthPrices.annual;
        if (durationGrowth) durationGrowth.textContent = '/mo billed annually';
      } else {
        toggleBtn?.classList.remove('active');
        labelMonthly?.classList.add('active');
        labelAnnually?.classList.remove('active');
        
        // Update starter
        if (priceStarter) priceStarter.textContent = starterPrices.monthly;
        if (durationStarter) durationStarter.textContent = '/mo';
        
        // Update growth
        if (priceGrowth) priceGrowth.textContent = growthPrices.monthly;
        if (durationGrowth) durationGrowth.textContent = '/mo';
      }

      // Add a quick visual swap animation
      [priceStarter, priceGrowth].forEach(el => {
        if (el) {
          el.style.transform = 'scale(0.95)';
          el.style.opacity = '0.7';
          setTimeout(() => {
            el.style.transform = 'scale(1)';
            el.style.opacity = '1';
          }, 100);
        }
      });
    };

    // Toggle click listeners
    toggleBtn?.addEventListener('click', updateBilling);
    
    // Label click listeners (convenience)
    labelMonthly?.addEventListener('click', () => {
      if (isAnnual) updateBilling();
    });
    labelAnnually?.addEventListener('click', () => {
      if (!isAnnual) updateBilling();
    });
  });
</script>
