---
---

<section class="security-section" id="security">
  <div class="container security-container">
    
    <!-- Left Column: Content -->
    <div class="security-content fade-up-init">
      <span class="badge security-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        Enterprise-Grade Isolation
      </span>
      <h2>Secured At The Database Level</h2>
      <p class="section-lead">
        We treat data privacy as a non-negotiable core feature. botforweb isolates tenant data completely using advanced PostgreSQL Row-Level Security (RLS) policies and isolated vector index namespaces.
      </p>

      <div class="security-pillars">
        <!-- Pillar 1 -->
        <div class="pillar-item">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <div>
            <h3>Row-Level Security (RLS)</h3>
            <p>Your data is strictly yours. PostgreSQL RLS policies guarantee zero tenant data leakage at the query planner level. If a database session isn't authenticated as your tenant, it cannot physically scan your records.</p>
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="pillar-item">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div>
            <h3>Groundedness Validation</h3>
            <p>The chatbot runs real-time semantic cross-checks on generated answers. If the requested information is absent or missing in your source files, the bot declines to answer instead of fabricating details.</p>
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="pillar-item">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <div>
            <h3>Hybrid Search Engine</h3>
            <p>We combine dense vector similarity matching (for semantic meaning) with BM25 sparse keyword searches. Technical terms, exact serial codes, and identifiers are never missed.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Diagram -->
    <div class="security-visual fade-up-init delay-200">
      <div class="security-diagram-card">
        <div class="diagram-header">
          <div class="diagram-title-group">
            <div class="diagram-title">Data Isolation Flow</div>
            <div class="diagram-subtitle">AES-256 Keys Rotated • 100% Isolated</div>
          </div>
          <span class="shield-badge">Validated</span>
        </div>

        <div class="diagram-body">
          <!-- Tenant Block -->
          <div class="diagram-row">
            <div class="diagram-node node-emerald" id="nodeClientQuery">
              <span class="node-label">Client Query</span>
              <span class="node-desc">"How to auth?"</span>
            </div>
            
            <div class="flow-arrow horizontal">
              <div class="pulse-dot"></div>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--border-dark)" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>

            <div class="diagram-node node-teal" id="nodeAuthCheck">
              <span class="node-label">JWT Verification</span>
              <span class="node-desc">Tenant ID Decoded</span>
            </div>
          </div>

          <!-- Vertical Flow Arrow -->
          <div class="flow-arrow vertical">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--border-dark)" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 19 19 12"/></svg>
          </div>

          <!-- RLS Gate -->
          <div class="diagram-node node-dark" id="nodeRlsGate">
            <div class="gate-header">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              <span>POSTGRES RLS ENGINE</span>
            </div>
            <pre><code>USING (tenant_id = current_tenant());</code></pre>
          </div>

          <!-- Vertical Flow Arrow -->
          <div class="flow-arrow vertical">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--border-dark)" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 19 19 12"/></svg>
          </div>

          <!-- Databases Grid -->
          <div class="diagram-db-grid">
            <!-- Namespace 1 -->
            <div class="db-namespace border-teal">
              <div class="db-title-bar">
                <span class="active-dot"></span>
                <span>Namespace: bfw_4a1f</span>
              </div>
              <div class="db-metric">Your Vectors Only</div>
            </div>

            <!-- Namespace 2 (Blocked) -->
            <div class="db-namespace blocked">
              <div class="db-title-bar">
                <span class="blocked-dot"></span>
                <span>Namespace: bfw_c74b</span>
              </div>
              <div class="db-metric">Access Denied</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .security-section {
    padding: 8rem 0;
    background-color: var(--bg-primary);
    overflow: hidden;
  }

  .security-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .security-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .security-badge {
    align-self: flex-start;
    background-color: var(--accent-soft);
    border-color: var(--accent-light);
    color: var(--accent);
  }

  .security-content h2 {
    font-size: 2.75rem;
    font-weight: 700;
    margin-bottom: 0;
    line-height: 1.2;
  }

  .section-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .security-pillars {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pillar-item {
    display: flex;
    gap: 1rem;
  }

  .pillar-bullet {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background-color: var(--accent-soft);
    border: 1px solid var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .pillar-item h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.375rem;
    color: var(--text-primary);
  }

  .pillar-item p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Right column diagram */
  .security-diagram-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-xl);
  }

  .diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
  }

  .diagram-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .diagram-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .diagram-subtitle {
    font-size: 0.675rem;
    color: var(--text-light);
    font-family: var(--font-mono);
  }

  .shield-badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.725rem;
    font-weight: 600;
    color: var(--success);
    background-color: var(--success-soft);
    border: 1px solid var(--success-light);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
  }

  .diagram-body {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .diagram-row {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .diagram-node {
    border-radius: var(--radius-md);
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--border-color);
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 140px;
    box-shadow: var(--shadow-sm);
  }

  .node-emerald {
    border-color: #a7f3d0; /* Emerald 200 */
    background-color: #ecfdf5; /* Emerald 50 */
  }

  .node-teal {
    border-color: #99f6e4; /* Teal 200 */
    background-color: #f0fdfa; /* Teal 50 */
  }

  .node-dark {
    width: 100%;
    background-color: var(--text-primary);
    border-color: var(--text-primary);
    color: #ffffff;
    padding: 1rem;
    align-items: flex-start;
    text-align: left;
  }

  .node-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-primary);
  }

  .node-desc {
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .gate-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.725rem;
    font-weight: 700;
    color: #a5b4fc; /* Indigo 300 */
    margin-bottom: 0.5rem;
  }

  .node-dark pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--success);
  }

  /* Arrows */
  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .flow-arrow.horizontal {
    flex-grow: 1;
  }

  .flow-arrow.vertical {
    height: 36px;
    margin: 4px 0;
  }

  .pulse-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: var(--accent);
    border-radius: var(--radius-full);
    animation: flowPulse 2s infinite linear;
  }

  @keyframes flowPulse {
    0% { left: 0%; opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }

  /* Database layout */
  .diagram-db-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    width: 100%;
  }

  .db-namespace {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background-color: #ffffff;
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    box-shadow: var(--shadow-sm);
  }

  .border-teal {
    border-color: var(--accent-light);
    box-shadow: 0 4px 12px rgba(13, 148, 136, 0.05);
  }

  .db-namespace.blocked {
    background-color: #fef2f2;
    border-color: #fee2e2;
    opacity: 0.75;
  }

  .db-title-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .active-dot, .blocked-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
  }

  .active-dot { background-color: var(--success); }
  .blocked-dot { background-color: #ef4444; }

  .db-metric {
    font-size: 0.675rem;
    color: var(--text-muted);
  }

  .blocked .db-title-bar {
    color: #b91c1c;
  }

  .blocked .db-metric {
    color: #ef4444;
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .security-container {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 768px) {
    .security-content h2 {
      font-size: 2.25rem;
    }
    .security-diagram-card {
      padding: 1.25rem;
    }
    .diagram-node {
      min-width: 110px;
      padding: 0.5rem;
    }
  }
</style>
