---
---

<section class="security-section" id="security">
  <div class="container security-container">

    <!-- Left Column: Content -->
    <div class="security-content fade-up-init">
      <span class="badge security-badge">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
        </svg>
        Enterprise-Grade Isolation
      </span>
      <h2>Secured At The Database Level</h2>
      <p class="section-lead">
        We treat data privacy as a non-negotiable core feature. botforweb isolates tenant data completely using advanced PostgreSQL Row-Level Security (RLS) policies and isolated vector index namespaces.
      </p>

      <div class="security-pillars">
        <!-- Pillar 1 -->
        <div class="pillar-item fade-up-init stagger-1">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
            </svg>
          </div>
          <div>
            <h3>Row-Level Security (RLS)</h3>
            <p>Your data is strictly yours. PostgreSQL RLS policies guarantee zero tenant data leakage at the query planner level. If a database session isn't authenticated as your tenant, it cannot physically scan your records.</p>
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="pillar-item fade-up-init stagger-2">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
          </div>
          <div>
            <h3>Groundedness Validation</h3>
            <p>The chatbot runs real-time semantic cross-checks on generated answers. If the requested information is absent or missing in your source files, the bot declines to answer instead of fabricating details.</p>
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="pillar-item fade-up-init stagger-3">
          <div class="pillar-bullet">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <div>
            <h3>Hybrid Search Engine</h3>
            <p>We combine dense vector similarity matching (for semantic meaning) with BM25 sparse keyword searches. Technical terms, exact serial codes, and identifiers are never missed.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Animated Flow Diagram -->
    <div class="security-visual fade-up-init delay-200">
      <div class="security-diagram-card">
        <div class="diagram-header">
          <div class="diagram-title-group">
            <div class="diagram-title">Data Isolation Flow</div>
            <div class="diagram-subtitle">AES-256 Keys Rotated • 100% Isolated</div>
          </div>
          <span class="shield-badge">
            <span class="shield-dot"></span>
            Validated
          </span>
        </div>

        <div class="diagram-body">
          <!-- Top Row: Client Query → JWT Verification -->
          <div class="diagram-row">
            <div class="diagram-node node-emerald" id="nodeClientQuery">
              <span class="node-label">Client Query</span>
              <span class="node-desc">"How to auth?"</span>
            </div>

            <div class="flow-arrow horizontal">
              <svg class="arrow-line" width="100%" height="24" viewBox="0 0 100 24" preserveAspectRatio="none">
                <line x1="0" y1="12" x2="85" y2="12" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="4 3"/>
                <polyline points="80,7 88,12 80,17" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
              </svg>
              <div class="pulse-dot"></div>
            </div>

            <div class="diagram-node node-teal" id="nodeAuthCheck">
              <span class="node-label">JWT Verification</span>
              <span class="node-desc">Tenant ID Decoded</span>
            </div>
          </div>

          <!-- Vertical Arrow Down -->
          <div class="flow-arrow vertical">
            <svg width="24" height="36" viewBox="0 0 24 36" fill="none">
              <line x1="12" y1="2" x2="12" y2="28" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="4 3"/>
              <polyline points="7,24 12,32 17,24" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
            </svg>
          </div>

          <!-- RLS Gate -->
          <div class="diagram-node node-rls" id="nodeRlsGate">
            <div class="gate-header">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>
              </svg>
              <span>POSTGRES RLS ENGINE</span>
            </div>
            <pre><code>USING (tenant_id = current_tenant());</code></pre>
          </div>

          <!-- Vertical Arrow Down -->
          <div class="flow-arrow vertical">
            <svg width="24" height="36" viewBox="0 0 24 36" fill="none">
              <line x1="12" y1="2" x2="12" y2="28" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="4 3"/>
              <polyline points="7,24 12,32 17,24" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5"/>
            </svg>
          </div>

          <!-- Database Grid -->
          <div class="diagram-db-grid">
            <!-- Namespace 1 (active) -->
            <div class="db-namespace ns-active">
              <div class="db-title-bar">
                <span class="active-dot"></span>
                <span>bfw_4a1f</span>
              </div>
              <div class="db-metric">Your Vectors Only</div>
            </div>

            <!-- Namespace 2 (blocked) -->
            <div class="db-namespace ns-blocked">
              <div class="db-title-bar">
                <span class="blocked-dot"></span>
                <span>bfw_c74b</span>
              </div>
              <div class="db-metric">Access Denied</div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const observerSecurity = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('fade-up-active');
        }
      });
    },
    { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
  );

  document.querySelectorAll('#security .fade-up-init').forEach((el) => {
    observerSecurity.observe(el);
  });
</script>

<style>
  /* ─── Section ─── */
  .security-section {
    padding: 8rem 0;
    background: var(--bg-primary);
    overflow: hidden;
    position: relative;
  }

  .security-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  /* ─── Left Column ─── */
  .security-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .security-badge {
    align-self: flex-start;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent);
  }

  .security-content h2 {
    font-size: 2.75rem;
    font-weight: 700;
    margin-bottom: 0;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .section-lead {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.5rem;
  }

  /* ─── Pillars ─── */
  .security-pillars {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .pillar-item {
    display: flex;
    gap: 1rem;
  }

  .pillar-bullet {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
    transition: all var(--transition-normal);
  }

  .pillar-item:hover .pillar-bullet {
    background: var(--accent-glow);
    border-color: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .pillar-item h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .pillar-item p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0;
  }

  /* ─── Right Column — Diagram Card ─── */
  .security-diagram-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2rem;
    box-shadow: var(--shadow-xl);
    transition: border-color var(--transition-slow);
  }

  .security-diagram-card:hover {
    border-color: var(--border-hover);
  }

  /* ─── Diagram Header ─── */
  .diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .diagram-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .diagram-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-title);
  }

  .diagram-subtitle {
    font-size: 0.675rem;
    color: var(--text-light);
    font-family: var(--font-mono);
  }

  .shield-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--success);
    background: var(--success-soft);
    border: 1px solid rgba(16, 185, 129, 0.15);
    padding: 0.25rem 0.7rem;
    border-radius: var(--radius-full);
  }

  .shield-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    background: var(--success);
    animation: dot-pulse 2s infinite;
  }

  /* ─── Diagram Body ─── */
  .diagram-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ─── Diagram Row (Top) ─── */
  .diagram-row {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 0;
  }

  /* ─── Nodes ─── */
  .diagram-node {
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 130px;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .diagram-node:hover {
    transform: translateY(-1px);
  }

  .node-label {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .node-desc {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  /* Green-tinted node */
  .node-emerald {
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.15);
  }

  .node-emerald:hover {
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.08);
  }

  /* Teal-tinted node */
  .node-teal {
    background: rgba(20, 184, 166, 0.06);
    border: 1px solid rgba(20, 184, 166, 0.15);
  }

  .node-teal:hover {
    box-shadow: 0 0 16px rgba(20, 184, 166, 0.08);
  }

  /* RLS Gate node */
  .node-rls {
    width: 100%;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    padding: 1rem 1.25rem;
    align-items: flex-start;
    text-align: left;
  }

  .node-rls:hover {
    border-color: var(--border-hover);
    box-shadow: 0 0 20px rgba(165, 180, 252, 0.05);
  }

  .gate-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: #4f46e5;
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gate-header svg {
    stroke: #4f46e5;
  }

  .node-rls pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #059669;
    line-height: 1.4;
  }

  .node-rls code {
    font-family: var(--font-mono);
  }

  /* ─── Flow Arrows ─── */
  .flow-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .flow-arrow.horizontal {
    flex: 1;
    min-width: 40px;
    padding: 0 0.25rem;
  }

  .flow-arrow.vertical {
    height: 36px;
    margin: 4px 0;
  }

  /* Pulse dot on horizontal arrow */
  .pulse-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 8px var(--accent-glow);
    animation: flowPulse 3s infinite ease-in-out;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  @keyframes flowPulse {
    0% {
      left: 5%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      left: 90%;
      opacity: 0;
    }
  }

  /* ─── Database Grid ─── */
  .diagram-db-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .db-namespace {
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .ns-active {
    background: rgba(16, 185, 129, 0.04);
    border: 1px solid rgba(16, 185, 129, 0.15);
  }

  .ns-active:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(16, 185, 129, 0.06);
  }

  .ns-blocked {
    background: rgba(239, 68, 68, 0.04);
    border: 1px solid rgba(239, 68, 68, 0.12);
    opacity: 0.6;
  }

  .db-title-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .ns-blocked .db-title-bar {
    color: var(--error);
  }

  .active-dot,
  .blocked-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .active-dot {
    background: var(--success);
    animation: dot-pulse 2s infinite;
  }

  .blocked-dot {
    background: var(--error);
  }

  .db-metric {
    font-size: 0.675rem;
    color: var(--text-muted);
    padding-left: 1.05rem;
  }

  .ns-blocked .db-metric {
    color: rgba(239, 68, 68, 0.7);
  }

  /* ─── Responsive — 968px ─── */
  @media (max-width: 968px) {
    .security-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .security-content {
      text-align: left;
    }
  }

  /* ─── Responsive — 768px ─── */
  @media (max-width: 768px) {
    .security-section {
      padding: 5rem 0;
    }

    .security-content h2 {
      font-size: 2rem;
    }

    .section-lead {
      font-size: 1rem;
    }

    .security-diagram-card {
      padding: 1.25rem;
    }

    .diagram-node {
      min-width: 100px;
      padding: 0.6rem 0.75rem;
    }

    .node-label {
      font-size: 0.72rem;
    }

    .node-desc {
      font-size: 0.625rem;
    }

    .node-rls pre {
      font-size: 0.65rem;
    }

    .gate-header {
      font-size: 0.625rem;
    }

    .db-title-bar {
      font-size: 0.625rem;
    }

    .db-metric {
      font-size: 0.6rem;
    }

    .diagram-db-grid {
      gap: 0.75rem;
    }
  }

  /* ─── Responsive — 480px ─── */
  @media (max-width: 480px) {
    .security-container {
      gap: 2.5rem;
    }

    .security-content h2 {
      font-size: 1.75rem;
    }

    .diagram-row {
      flex-direction: column;
      gap: 0;
    }

    .flow-arrow.horizontal {
      transform: rotate(90deg);
      min-width: unset;
      height: 40px;
      flex: unset;
    }

    .diagram-node {
      min-width: unset;
      width: 100%;
    }

    .diagram-db-grid {
      grid-template-columns: 1fr;
    }

    .node-rls pre {
      font-size: 0.6rem;
      overflow-x: auto;
    }
  }
</style>
