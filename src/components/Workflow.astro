---
---

<section class="workflow-section" id="how-it-works">
  <div class="container">
    <!-- Header -->
    <div class="section-header fade-up-init">
      <span class="badge">Simple Setup</span>
      <h2>Launch Your Assistant In 3 Steps</h2>
      <p class="section-desc">
        A completely automated ingestion pipeline that handles parsing, chunking, embedding, and widget deployment in under five minutes.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid-3 workflow-grid">
      <!-- Step 1 -->
      <div class="workflow-card fade-up-init delay-100" id="step1Card">
        <div class="step-watermark">01</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <h3>Upload Docs</h3>
        <p>Drag & drop PDFs or Markdown. Celery parses and indexes your files asynchronously, extracting headers and key segments.</p>

        <!-- Visual Demo -->
        <div class="workflow-visual">
          <div class="visual-box upload-visual">
            <div class="file-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
              </svg>
              <span>manual.pdf</span>
            </div>
            <svg class="flow-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
            <div class="db-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse cx="12" cy="5" rx="9" ry="3"/>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>
              </svg>
              <span>Ingested</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="workflow-card fade-up-init delay-200" id="step2Card">
        <div class="step-watermark">02</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2Z"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
        </div>
        <h3>Auto-Vectorization</h3>
        <p>The engine splits text into semantic chunks, generates dense/sparse embeddings, and stores them in isolated database namespaces.</p>

        <!-- Visual Demo -->
        <div class="workflow-visual">
          <div class="visual-box vector-visual">
            <span class="chunk-label">"auth key"</span>
            <svg class="flow-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
            <span class="vector-pill">[0.42, -0.89, ...]</span>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="workflow-card fade-up-init delay-300" id="step3Card">
        <div class="step-watermark">03</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3>Embed Widget</h3>
        <p>Copy the single-line JS script tag and paste it onto your site. The chatbot is instantly live, customized to your styling.</p>

        <!-- Visual Demo -->
        <div class="workflow-visual">
          <div class="visual-box code-visual">
            <code>&lt;script src="widget.js"&gt;&lt;/script&gt;</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Section ─── */
  .workflow-section {
    position: relative;
    padding: 8rem 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }
  /* ─── Grid ─── */
  .workflow-grid {
    margin-top: 0;
  }

  @media (min-width: 769px) {
    .workflow-grid {
      grid-template-columns: repeat(3, 1fr) !important;
    }
  }

  /* ─── Card ─── */
  .workflow-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: var(--surface-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    overflow: hidden;
    transition: all var(--transition-normal);
  }

  .workflow-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  /* ─── Step Watermark ─── */
  .step-watermark {
    position: absolute;
    top: 1rem;
    right: 1.5rem;
    font-family: var(--font-title);
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--border-color);
    line-height: 1;
    user-select: none;
    pointer-events: none;
    z-index: 0;
    opacity: 0.8;
  }

  /* ─── Icon Wrapper ─── */
  .workflow-icon-wrapper {
    position: relative;
    z-index: 1;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ─── Text Content ─── */
  .workflow-card h3 {
    position: relative;
    z-index: 1;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0;
    color: var(--text-primary);
  }

  .workflow-card p {
    position: relative;
    z-index: 1;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
    flex-grow: 1;
  }

  /* ─── Visual Demo Area ─── */
  .workflow-visual {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .visual-box {
    height: 56px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    gap: 0.625rem;
    font-family: var(--font-sans);
  }

  /* ─── Step 1 — Upload Visual ─── */
  .upload-visual {
    gap: 0.5rem;
  }

  .file-pill,
  .db-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    border: 1px solid var(--border-color);
    background: var(--bg-tertiary);
    color: var(--text-secondary);
  }

  .db-pill {
    color: var(--success);
    border-color: var(--success-light);
    background: var(--success-soft);
  }

  .flow-arrow {
    flex-shrink: 0;
  }

  /* ─── Step 2 — Vector Visual ─── */
  .vector-visual {
    gap: 0.5rem;
  }

  .chunk-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .vector-pill {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  /* ─── Step 3 — Code Visual ─── */
  .code-visual {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    overflow-x: hidden;
  }

  .code-visual code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--text-primary);
    white-space: nowrap;
    opacity: 0.9;
    letter-spacing: -0.01em;
  }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .workflow-section {
      padding: 5rem 0;
    }

    .workflow-grid {
      grid-template-columns: 1fr;
    }

    .step-watermark {
      font-size: 2.5rem;
    }

    .workflow-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
