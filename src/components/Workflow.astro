---
---

<section class="workflow-section" id="how-it-works">
  <div class="container">
    <!-- Header -->
    <div class="section-header fade-up-init">
      <span class="badge">Simple Setup</span>
      <h2>Launch Your Assistant In 3 Steps</h2>
      <p class="section-desc">
        A completely automated ingestion pipeline that handles parsing, chunking, embedding, and widget deployment in under five minutes.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid-3 workflow-grid">
      <!-- Step 1 -->
      <div class="card workflow-card fade-up-init delay-100" id="step1Card">
        <div class="step-num-badge">01</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="17 8 12 3 7 8"/>
            <line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </div>
        <h3>Upload Docs</h3>
        <p>Drag & drop PDFs or Markdown. Celery parses and indexes your files asynchronously, extracting headers and key segments.</p>
        
        <!-- Interactive Visual: Upload representation -->
        <div class="workflow-visual">
          <div class="visual-box upload-visual-container">
            <div class="file-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
              <span>manual.pdf</span>
            </div>
            <svg class="arrow-down-animate" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--text-light)" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/>
            </svg>
            <div class="db-pill">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/></svg>
              <span>Ingested</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="card workflow-card fade-up-init delay-200" id="step2Card">
        <div class="step-num-badge">02</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2Z"/>
            <polyline points="2 17 12 22 22 17"/>
            <polyline points="2 12 12 17 22 12"/>
          </svg>
        </div>
        <h3>Auto-Vectorization</h3>
        <p>The engine splits text into semantic chunks, generates dense/sparse embeddings, and stores them in isolated database namespaces.</p>
        
        <!-- Interactive Visual: Embedding representation -->
        <div class="workflow-visual">
          <div class="visual-box vector-visual-container">
            <span class="chunk-label">"auth key"</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            <span class="vector-pill">[0.42, -0.89, ...]</span>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="card workflow-card fade-up-init delay-300" id="step3Card">
        <div class="step-num-badge">03</div>
        <div class="workflow-icon-wrapper">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 18 22 12 16 6"/>
            <polyline points="8 6 2 12 8 18"/>
          </svg>
        </div>
        <h3>Embed Widget</h3>
        <p>Copy the single-line JS script tag and paste it onto your site. The chatbot is instantly live, customized to your styling.</p>
        
        <!-- Interactive Visual: Script tag preview -->
        <div class="workflow-visual">
          <div class="visual-box code-visual-container">
            <code>&lt;script src="widget.js"&gt;&lt;/script&gt;</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .workflow-section {
    position: relative;
    padding: 7.5rem 0;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .section-header {
    max-width: 650px;
    margin: 0 auto 4.5rem auto;
    text-align: center;
  }

  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-top: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .workflow-grid {
    margin-top: 2rem;
  }

  .workflow-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    overflow: hidden;
  }

  .workflow-card:hover {
    transform: translateY(-4px);
  }

  .step-num-badge {
    position: absolute;
    top: 1.5rem;
    right: 2.25rem;
    font-family: var(--font-title);
    font-size: 3rem;
    font-weight: 800;
    color: var(--bg-tertiary);
    line-height: 1;
    user-select: none;
    opacity: 0.8;
  }

  .workflow-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background-color: var(--accent-soft);
    border: 1px solid var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .workflow-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0;
  }

  .workflow-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    flex-grow: 1;
  }

  /* Visual demonstrations in card feet */
  .workflow-visual {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-color);
  }

  .visual-box {
    height: 64px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    padding: 0 1rem;
  }

  /* Step 1 Visual */
  .upload-visual-container {
    gap: 0.5rem;
  }

  .file-pill, .db-pill {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.65rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: #ffffff;
    font-weight: 500;
  }

  .file-pill {
    color: var(--accent);
    border-color: var(--accent-light);
  }

  .db-pill {
    color: var(--success);
    border-color: var(--success-light);
    background-color: var(--success-soft);
  }

  .arrow-down-animate {
    animation: bounceDown 2s infinite ease-in-out;
  }

  @keyframes bounceDown {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  /* Step 2 Visual */
  .vector-visual-container {
    gap: 0.5rem;
    font-size: 0.65rem;
  }

  .chunk-label {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    font-weight: 600;
  }

  .vector-pill {
    font-family: var(--font-mono);
    color: var(--accent);
    background-color: #ffffff;
    border: 1px solid var(--accent-light);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  /* Step 3 Visual */
  .code-visual-container {
    background-color: var(--text-primary);
    border: none;
    color: var(--success);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    overflow-x: hidden;
  }

  .code-visual-container code {
    white-space: nowrap;
    opacity: 0.95;
  }

  @media (max-width: 768px) {
    .section-header h2 {
      font-size: 2rem;
    }
    
    .step-num-badge {
      font-size: 2.25rem;
    }
  }
</style>
